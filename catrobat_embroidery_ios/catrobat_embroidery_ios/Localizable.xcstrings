    "palette.row.accessibility.label": {
      "comment": "Spoken by VoiceOver for one brick in the list of bricks to add. %1$@ is the brick as it will appear in the design, e.g. \"Wait 1 second\"; %2$@ is a one-line description of what it does; both arrive already translated. Use the sentence-ending punctuation and spacing your language reads naturally. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
