    "project.row.accessibility.label.damaged": {
      "comment": "Spoken by VoiceOver for one of the user's designs that could not be read: it cannot be opened, only deleted. %1$@ is the design's name, %2$@ a relative time that arrives already translated. Must agree with project.row.badge.damaged. Arguments are positional and may be reordered.",
      "extractionState": "manual",
