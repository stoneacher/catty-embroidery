{
  "sourceLanguage": "en",
  "strings": {
    "autosave.failure.paused": {
      "comment": "Banner at the top of every window while saving is paused to avoid writing over an earlier design that could not be opened. It may appear in a window that never showed the alert, so it must make sense alone. It disappears on its own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving is paused so your earlier design stays safe."
          }
        }
      }
    },
    "autosave.failure.save": {
      "comment": "Banner at the top of every window while the app cannot save the user's work. It disappears on its own once saving works again, which happens on the next change or when the app goes to the background. Not an alert, and there is no button. Keep it short: it stays on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest changes couldn't be saved. The app will try again."
          }
        }
      }
    },
    "autosave.refusal.message.blocks.kept": {
      "comment": "Alert message: the saved design was read, but its blocks (the visual programming pieces, e.g. a 'repeat' without its end) do not form a valid program. 'Kept safe' means the old design was moved out of the way untouched. It was not copied, so do not say 'copy'. The user cannot open it yet, so promise nothing about getting it back. Keep the two sentences in one entry so pronouns can agree.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of its blocks don't fit together. It's been kept safe, and a new, empty design is open instead."
          }
        }
      }
    },
    "autosave.refusal.message.blocks.paused": {
      "comment": "Alert message: the saved design was read, but its blocks (the visual programming pieces, e.g. a 'repeat' without its end) do not form a valid program. The old design could not be moved out of the way, so the app stops saving to avoid writing over it. 'For now' matters: saving may start again later. Must match autosave.failure.paused in meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of its blocks don't fit together. A new, empty design is open instead, and to protect the old one, nothing will be saved for now."
          }
        }
      }
    },
    "autosave.refusal.message.damaged.kept": {
      "comment": "Alert message: the saved design could not be read. It may be damaged. Written for young users: do not use technical words like 'file' or 'data format'. 'Kept safe' means the old design was moved out of the way untouched. It was not copied, so do not say 'copy'. The user cannot open it yet, so promise nothing about getting it back. Keep the two sentences in one entry so pronouns can agree.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems to be damaged. It's been kept safe, and a new, empty design is open instead."
          }
        }
      }
    },
    "autosave.refusal.message.damaged.paused": {
      "comment": "Alert message: the saved design could not be read. It may be damaged. Written for young users: do not use technical words like 'file' or 'data format'. The old design could not be moved out of the way, so the app stops saving to avoid writing over it. 'For now' matters: saving may start again later. Must match autosave.failure.paused in meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems to be damaged. A new, empty design is open instead, and to protect the old one, nothing will be saved for now."
          }
        }
      }
    },
    "autosave.refusal.message.newer.kept": {
      "comment": "Alert message: the saved design was made by a newer version of this app, which this version cannot read. It is not broken. 'Kept safe' means the old design was moved out of the way untouched. It was not copied, so do not say 'copy'. The user cannot open it yet, so promise nothing about getting it back. Keep the two sentences in one entry so pronouns can agree.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was made with a newer version of this app. It's been kept safe, and a new, empty design is open instead."
          }
        }
      }
    },
    "autosave.refusal.message.newer.paused": {
      "comment": "Alert message: the saved design was made by a newer version of this app, which this version cannot read. It is not broken. The old design could not be moved out of the way, so the app stops saving to avoid writing over it. 'For now' matters: saving may start again later. Must match autosave.failure.paused in meaning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was made with a newer version of this app. A new, empty design is open instead, and to protect the old one, nothing will be saved for now."
          }
        }
      }
    },
    "autosave.refusal.title": {
      "comment": "Title of the alert shown once at launch when the design saved last time could not be opened. The message below says why and what happened. Title case, matching the other titles. 'Design' means an embroidery design the user built from blocks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Open Your Last Design"
          }
        }
      }
    },
    "brick.change.variable": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Adds an amount to a variable. %1$@ is the variable's name, chosen by the user and never translated; %2$@ is the amount; %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change %1$@ by %2$@"
          }
        }
      }
    },
    "brick.change.x": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Moves the needle horizontally by an amount. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Keep x as the axis name. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change x by %@"
          }
        }
      }
    },
    "brick.change.y": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Moves the needle vertically by an amount. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Keep y as the axis name. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change y by %@"
          }
        }
      }
    },
    "brick.forever": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Opens a loop whose blocks run until the program is stopped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forever"
          }
        }
      }
    },
    "brick.loop.end.forever": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Closes a Forever loop. Must read as the end of that specific kind of loop.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of forever"
          }
        }
      }
    },
    "brick.loop.end.repeat": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Closes a repeat loop. It repeats the loop's own count so a user can tell which loop it closes. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. This form is used when the value is a formula, a variable or a fraction. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of repeat %@ times"
          }
        }
      }
    },
    "brick.loop.end.repeat.count": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Closes a repeat loop. It repeats the loop's own count so a user can tell which loop it closes. %lld is a whole number written literally in the block; this form is used only then, so that the unit agrees with it (\"1 second\", \"2 seconds\"). Add the plural categories your language needs. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "End of repeat %lld time"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "End of repeat %lld times"
                }
              }
            }
          }
        }
      }
    },
    "brick.loop.end.unmatched": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Closes a loop whose start is missing. Rare; appears only in a damaged design.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of loop"
          }
        }
      }
    },
    "brick.move": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Moves the needle forward by a number of steps. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. This form is used when the value is a formula, a variable or a fraction. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %@ steps"
          }
        }
      }
    },
    "brick.move.count": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Moves the needle forward by a number of steps. %lld is a whole number written literally in the block; this form is used only then, so that the unit agrees with it (\"1 second\", \"2 seconds\"). Add the plural categories your language needs. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Move %lld step"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Move %lld steps"
                }
              }
            }
          }
        }
      }
    },
    "brick.place.at": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Moves the needle to a point. %1$@ is the x coordinate, %2$@ the y coordinate; %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Keep x and y as the axis names. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place at x: %1$@ y: %2$@"
          }
        }
      }
    },
    "brick.point.direction": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Sets the needle's heading; 90 degrees points right. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. This form is used when the value is a formula, a variable or a fraction. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point in direction %@ degrees"
          }
        }
      }
    },
    "brick.point.direction.count": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Sets the needle's heading; 90 degrees points right. %lld is a whole number written literally in the block; this form is used only then, so that the unit agrees with it (\"1 second\", \"2 seconds\"). Add the plural categories your language needs. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Point in direction %lld degree"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Point in direction %lld degrees"
                }
              }
            }
          }
        }
      }
    },
    "brick.repeat": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Opens a loop: the blocks inside it run this many times. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. This form is used when the value is a formula, a variable or a fraction. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat %@ times"
          }
        }
      }
    },
    "brick.repeat.count": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Opens a loop: the blocks inside it run this many times. %lld is a whole number written literally in the block; this form is used only then, so that the unit agrees with it (\"1 second\", \"2 seconds\"). Add the plural categories your language needs. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Repeat %lld time"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Repeat %lld times"
                }
              }
            }
          }
        }
      }
    },
    "brick.running.stitch": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Starts sewing a running stitch as the needle moves. %@ is the stitch length; %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start running stitch with length %@"
          }
        }
      }
    },
    "brick.set.variable": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Stores a value in a variable. %1$@ is the variable's name, chosen by the user and never translated; %2$@ is the value; %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set %1$@ to %2$@"
          }
        }
      }
    },
    "brick.set.x": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Moves the needle horizontally to a coordinate. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Keep x as the axis name. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set x to %@"
          }
        }
      }
    },
    "brick.set.y": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Moves the needle vertically to a coordinate. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Keep y as the axis name. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set y to %@"
          }
        }
      }
    },
    "brick.sew.up": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Sews a short securing stitch so the thread does not come loose.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sew up"
          }
        }
      }
    },
    "brick.stitch": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Sews one stitch at the needle's position. An imperative verb.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stitch"
          }
        }
      }
    },
    "brick.stop.stitch": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Stops whichever running, zigzag or triple stitch was started.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop running stitch"
          }
        }
      }
    },
    "brick.thread.color": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Changes the thread colour. %@ is the colour as a web hex code such as #ff0000, shown exactly as stored. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set thread colour to %@"
          }
        }
      }
    },
    "brick.triple.stitch": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Starts sewing a triple (reinforced) stitch as the needle moves. %@ is the stitch length; %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start triple stitch with length %@"
          }
        }
      }
    },
    "brick.turn.left": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Turns the needle's heading anticlockwise. %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. This form is used when the value is a formula, a variable or a fraction. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn left %@ degrees"
          }
        }
      }
    },
