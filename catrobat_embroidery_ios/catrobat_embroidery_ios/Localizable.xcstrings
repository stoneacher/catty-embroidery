    "parameter.comparison": {
      "comment": "Title of the menu that chooses how a condition compares its two values (equal to, less than, …). Catroid's wording: 'Comparison operators'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison"
          }
        }
      }
    },
    "parameter.comparison.equal": {
      "comment": "One of the six ways the condition editor can compare two values, in the menu that chooses it. Spoken by VoiceOver, so it is the name of the comparison, never its symbol. The symbol is =.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equal to"
          }
        }
      }
    },
    "parameter.comparison.first": {
      "comment": "Title of the editor for the first of the two values a condition compares, e.g. 'Counter' in 'Counter < 10'. Not 'left': the order is reading order.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First value"
          }
        }
      }
    },
    "parameter.comparison.greater.or.equal": {
      "comment": "One of the six ways the condition editor can compare two values, in the menu that chooses it. Spoken by VoiceOver, so it is the name of the comparison, never its symbol. The symbol is ≥.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greater than or equal to"
          }
        }
      }
    },
    "parameter.comparison.greater.than": {
      "comment": "One of the six ways the condition editor can compare two values, in the menu that chooses it. Spoken by VoiceOver, so it is the name of the comparison, never its symbol. The symbol is >.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greater than"
          }
        }
      }
    },
    "parameter.comparison.not.equal": {
      "comment": "One of the six ways the condition editor can compare two values, in the menu that chooses it. Spoken by VoiceOver, so it is the name of the comparison, never its symbol. The symbol is ≠.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not equal to"
          }
        }
      }
    },
    "parameter.comparison.second": {
      "comment": "Title of the editor for the second of the two values a condition compares, e.g. '10' in 'Counter < 10'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Second value"
          }
        }
      }
    },
    "parameter.comparison.smaller.or.equal": {
      "comment": "One of the six ways the condition editor can compare two values, in the menu that chooses it. Spoken by VoiceOver, so it is the name of the comparison, never its symbol. The symbol is ≤.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than or equal to"
          }
        }
      }
    },
    "parameter.comparison.smaller.than": {
      "comment": "One of the six ways the condition editor can compare two values, in the menu that chooses it. Spoken by VoiceOver, so it is the name of the comparison, never its symbol. The symbol is <.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than"
          }
        }
      }
    },
    "parameter.editor.action.edit": {
      "comment": "VoiceOver action on a brick row. Selects the brick and opens the editor for its numbers, variable, colour or file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Parameters"
          }
        }
      }
    },
    "parameter.editor.done": {
      "comment": "Closes the brick editor. Changes are already applied; this only closes it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "parameter.editor.edit": {
      "comment": "Toolbar button under the brick list. Opens the editor for the selected brick's numbers, variable, colour or file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        }
      }
    },
    "parameter.editor.title": {
      "comment": "Title of the sheet or popover that edits one brick's values.",
