    "brick.write.file": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Saves the design so far to a file. %@ is the file name, shown exactly as stored. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write embroidery to file %@"
          }
        }
      }
    },
    "brick.zigzag.stitch": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Starts sewing a zigzag stitch as the needle moves. %1$@ is the stitch length, %2$@ the zigzag width; %@ is a value that may be a number, a variable name or a small formula such as \"360 ÷ Inner Loop\", already formatted. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start zigzag stitch with length %1$@ and width %2$@"
          }
        }
      }
    },
    "formula.divide": {
      "comment": "An arithmetic operator inside a block's value, e.g. in \"360 ÷ Inner Loop\". %1$@ and %2$@ are its two operands, already formatted. Use the symbol a pupil in your language would write; keep the spaces unless your language does not use them. Division. Some languages write a colon instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ÷ %2$@"
          }
        }
      }
    },
    "formula.group": {
      "comment": "Parentheses around part of a formula inside a block's value, e.g. the \"(a + b)\" in \"−(a + b)\". %@ is the part, already formatted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(%@)"
          }
        }
      }
    },
    "formula.minus": {
      "comment": "An arithmetic operator inside a block's value, e.g. in \"360 ÷ Inner Loop\". %1$@ and %2$@ are its two operands, already formatted. Use the symbol a pupil in your language would write; keep the spaces unless your language does not use them. Subtraction. The symbol is the true minus sign (U+2212), not a hyphen, so VoiceOver reads it as \"minus\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ − %2$@"
          }
        }
      }
    },
    "formula.mult": {
      "comment": "An arithmetic operator inside a block's value, e.g. in \"360 ÷ Inner Loop\". %1$@ and %2$@ are its two operands, already formatted. Use the symbol a pupil in your language would write; keep the spaces unless your language does not use them. Multiplication.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ × %2$@"
          }
        }
      }
    },
    "formula.negate": {
      "comment": "A negative value or negated formula inside a block's value, e.g. \"−5\". %@ is the value, already formatted. The symbol is the true minus sign (U+2212), not a hyphen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "−%@"
          }
        }
      }
    },
    "formula.plus": {
      "comment": "An arithmetic operator inside a block's value, e.g. in \"360 ÷ Inner Loop\". %1$@ and %2$@ are its two operands, already formatted. Use the symbol a pupil in your language would write; keep the spaces unless your language does not use them. Addition.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ + %2$@"
          }
        }
      }
    },
    "formula.pow": {
      "comment": "An arithmetic operator inside a block's value, e.g. in \"360 ÷ Inner Loop\". %1$@ and %2$@ are its two operands, already formatted. Use the symbol a pupil in your language would write; keep the spaces unless your language does not use them. Raising %1$@ to the power %2$@.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ^ %2$@"
          }
        }
      }
    },
    "formula.variable": {
      "comment": "A variable's name inside a block's value, e.g. the \"Inner Loop\" in 360 ÷ \"Inner Loop\". %@ is the name, chosen by the user and never translated. The quotes are what keep a name like \"a + b\" reading as one variable rather than as a sum — use your language's quotation marks, but keep them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\""
          }
        }
      }
    },
    "program.title.named": {
      "comment": "The stage's title for a design reopened from the last session. %@ is the name the design was saved under, exactly as the user or the sample gave it. Do not translate: keep %@ alone, with nothing around it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "program.title.untitled": {
      "comment": "The title of a design that has no name yet: the blank design every new window starts with, and a design reopened from the last session without a name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled Design"
          }
        }
      }
    },
    "root.sample.accessibility.label": {
      "comment": "Spoken by VoiceOver for one row of the list of example designs. %1$@ is the design's name, %2$@ is a one-line description of what it looks like; both arrive already translated. The separator is what makes VoiceOver pause between them — use the sentence-ending punctuation and spacing your language reads naturally (which is not a full stop everywhere). Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
    "root.samples.header": {
      "comment": "Header of the list of ready-made embroidery designs bundled with the app, shown on the main screen. \"Designs\" here means embroidery patterns, not graphic design.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example Designs"
          }
        }
      }
    },
    "root.title": {
      "comment": "Title of the app's main screen, and the app's own name. Catrobat ships this app as \"Embroidery Designer\" on Android; keep the two consistent per locale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embroidery Designer"
          }
        }
      }
    },
    "script.action.delete": {
      "comment": "VoiceOver action on a brick in the script list: deletes it. On a loop, deletes the whole loop and everything inside it; it can be undone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "script.action.move.above.loop": {
      "comment": "VoiceOver action on the first brick inside a loop (a Repeat or Forever block): takes the brick out of the loop and puts it just above it. 'Loop' means the Repeat/Forever block the brick is inside.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Above Loop"
          }
        }
      }
    },
    "script.action.move.below.loop": {
      "comment": "VoiceOver action on the last brick inside a loop (a Repeat or Forever block): takes the brick out of the loop and puts it just below it. 'Loop' means the Repeat/Forever block the brick is inside.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Below Loop"
          }
        }
      }
    },
    "script.action.move.down": {
      "comment": "VoiceOver action on a brick in the script list: moves the brick below the brick (or whole loop) after it. Short imperative, like a menu item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Down"
          }
        }
      }
    },
    "script.action.move.up": {
      "comment": "VoiceOver action on a brick in the script list: moves the brick above the brick (or whole loop) before it. Short imperative, like a menu item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Up"
          }
        }
      }
    },
    "script.empty.description": {
      "comment": "Below 'No Bricks Yet'. Names the action, not a button: the button to add a brick arrives in a later version, and this text must stay true both before and after it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a brick to start your design."
          }
        }
      }
    },
    "script.empty.title": {
      "comment": "Title of the empty state shown in place of a design's list of blocks when it has none — the first thing a new user sees. 'Brick' is Catrobat's name for a block.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bricks Yet"
          }
        }
      }
    },
    "script.redo": {
      "comment": "Toolbar button under the script list: redoes the change that was just undone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo"
          }
        }
      }
    },
    "script.row.accessibility.nested": {
      "comment": "Spoken by VoiceOver for a block inside one or more loops, because a user who cannot see the indentation still needs to know it. %1$@ is the block's own sentence, e.g. \"Move 10 steps\"; %2$lld is how many loops it sits inside. Never shown on screen. Add the plural categories your language needs. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, inside %#@loops@"
          },
          "substitutions": {
            "loops": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg loop"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg loops"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "script.text.placeholder": {
      "comment": "Shown inside a block in place of a file name or thread colour the block holds as empty text, e.g. \"Write embroidery to file (empty)\", so the sentence does not look cut off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(empty)"
          }
        }
      }
    },
    "script.title": {
      "comment": "Title of the list of blocks that make up a design's program. On iPad this labels the middle column, between the list of example designs and the stage, which shows the design's own name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Script"
          }
        }
      }
    },
    "script.undo": {
      "comment": "Toolbar button under the script list: undoes the last change to the design.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        }
      }
    },
    "script.variable.placeholder": {
      "comment": "Shown inside a block in place of a variable's name when the block has no variable chosen yet, e.g. \"Set (no variable) to 1\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no variable)"
          }
        }
      }
    },
    "stage.canvas.accessibility.action.fit": {
      "comment": "Name of an accessibility action on the embroidery stage that returns the view to showing the whole design at once, undoing any zoom or pan. Spoken by VoiceOver and listed in the Switch Control actions menu, so it must read as an action the user can invoke. This is the only way to undo a zoom for users who cannot double-tap the stage: with VoiceOver running a double tap means \"activate\", and Switch Control has no double tap at all. \"Hoop\" is the frame that holds the fabric in an embroidery machine. Keep it consistent with stage.canvas.accessibility.hint.finished, which names it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit to Hoop"
          }
        }
      }
    },
    "stage.canvas.accessibility.action.pan.down": {
      "comment": "Name of an accessibility action on the embroidery stage that moves the user's view of the design. IMPORTANT: this is camera movement, not movement of the design — \"Pan Down\" means the view travels down, so more of the lower part of the design becomes visible and the design itself appears to move up. Translate the direction the viewer's attention travels, not the direction the design moves. The stage is a picture with a fixed physical orientation (an embroidery hoop), so left stays left in right-to-left languages — do not swap it for leading/trailing. Spoken by VoiceOver in the Actions rotor, listed in the Switch Control actions menu, and spoken verbatim by Voice Control users as \"Tap <name>\", so keep it short, imperative and clearly distinct from the three sibling directions and from stage.canvas.accessibility.action.fit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan Down"
          }
        }
      }
    },
    "stage.canvas.accessibility.action.pan.left": {
      "comment": "Name of an accessibility action on the embroidery stage that moves the user's view of the design. IMPORTANT: this is camera movement, not movement of the design — \"Pan Left\" means the view travels left, so more of the left-hand side of the design becomes visible and the design itself appears to move right. Translate the direction the viewer's attention travels, not the direction the design moves. The stage is a picture with a fixed physical orientation (an embroidery hoop), so left stays left in right-to-left languages — do not swap it for leading/trailing. Spoken by VoiceOver in the Actions rotor, listed in the Switch Control actions menu, and spoken verbatim by Voice Control users as \"Tap <name>\", so keep it short, imperative and clearly distinct from the three sibling directions and from stage.canvas.accessibility.action.fit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan Left"
          }
        }
      }
    },
    "stage.canvas.accessibility.action.pan.right": {
      "comment": "Name of an accessibility action on the embroidery stage that moves the user's view of the design. IMPORTANT: this is camera movement, not movement of the design — \"Pan Right\" means the view travels right, so more of the right-hand side of the design becomes visible and the design itself appears to move left. Translate the direction the viewer's attention travels, not the direction the design moves. The stage is a picture with a fixed physical orientation (an embroidery hoop), so left stays left in right-to-left languages — do not swap it for leading/trailing. Spoken by VoiceOver in the Actions rotor, listed in the Switch Control actions menu, and spoken verbatim by Voice Control users as \"Tap <name>\", so keep it short, imperative and clearly distinct from the three sibling directions and from stage.canvas.accessibility.action.fit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan Right"
          }
        }
      }
    },
    "stage.canvas.accessibility.action.pan.up": {
      "comment": "Name of an accessibility action on the embroidery stage that moves the user's view of the design. IMPORTANT: this is camera movement, not movement of the design — \"Pan Up\" means the view travels up, so more of the upper part of the design becomes visible and the design itself appears to move down. Translate the direction the viewer's attention travels, not the direction the design moves. The stage is a picture with a fixed physical orientation (an embroidery hoop), so left stays left in right-to-left languages — do not swap it for leading/trailing. Spoken by VoiceOver in the Actions rotor, listed in the Switch Control actions menu, and spoken verbatim by Voice Control users as \"Tap <name>\", so keep it short, imperative and clearly distinct from the three sibling directions and from stage.canvas.accessibility.action.fit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan Up"
          }
        }
      }
    },
    "stage.canvas.accessibility.colors": {
      "comment": "One part of the VoiceOver description of the embroidery stage, e.g. \"1 colour\". %lld is the number of *distinct* thread colours in the design, not the number of colour changes — a design that switches red, blue, red uses two colours. Spoken aloud, never shown on screen. Add the plural categories your language needs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld colour"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld colours"
                }
              }
            }
          }
        }
      }
    },
    "stage.canvas.accessibility.hint.finished": {
      "comment": "VoiceOver hint for the embroidery stage whenever a design is not currently being stitched. A hint says what the user can do here; what the stage holds is spoken separately as its value. \"Fit to Hoop\" must match the name of the action stage.canvas.accessibility.action.fit exactly, or the hint will name an action the user cannot find. Say \"pan\" generically rather than listing the four direction actions by name — hints are spoken after a delay and must stay short. Naming Fit to Hoop is required rather than decorative: panning has no limit, so a user can move the design off screen entirely and this is how they learn the way back. Describe the result of adjusting and panning rather than naming a gesture — VoiceOver, Switch Control and keyboard users each reach them differently and the system already explains how.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust to zoom the design in and out, pan to move around it, or use Fit to Hoop to see all of it."
          }
        }
      }
    },
    "stage.canvas.accessibility.hint.running": {
      "comment": "VoiceOver hint for the embroidery stage while a design is being stitched. A hint says what the user can do here. Mentions that stitching is in progress because that is useful alongside the actions, though it is also spoken as the stage's value for users who have turned hints off. \"Fit to Hoop\" must match the name of the action stage.canvas.accessibility.action.fit exactly. The design can be zoomed and panned while it is still being stitched, and panning has no limit, so this hint has to name the way back just as the stopped one does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stitching in progress. Adjust to zoom, pan to move around the design, or use Fit to Hoop to see all of it."
          }
        }
      }
    },
    "stage.canvas.accessibility.label": {
      "comment": "Spoken by VoiceOver for the drawing area that shows the embroidery design. A short name for the area only - the description of what it contains (stitch count, colours, size) is added in a later version and is not part of this string.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embroidery stage"
          }
        }
      }
    },
    "stage.canvas.accessibility.label.named": {
      "comment": "Spoken by VoiceOver as the name of the drawing area that shows the embroidery design, once a design has been chosen. %1$@ is the design's name, already translated. This names the area; what it contains is spoken separately as the area's value. It is read every time the user moves focus here, so keep it short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embroidery stage, %1$@"
          }
        }
      }
    },
    "stage.canvas.accessibility.size": {
      "comment": "The width and height of the finished embroidery design, spoken by VoiceOver as part of the stage's description, e.g. \"98.6 millimetres by 98.6 millimetres\". Both arguments are already-formatted lengths that include their unit name spelled out in full, localized for the reader's region. Do not add a unit, and do not state the unit once for both numbers: its spelling and position change with the number in many languages. The word between them is a dimension separator (width by height) and is spoken aloud, so use a word rather than the multiplication sign used in the visible hoop caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ by %2$@"
          }
        }
      }
    },
    "stage.canvas.accessibility.stitches": {
      "comment": "One part of the VoiceOver description of the embroidery stage, e.g. \"3,194 stitches\". %lld is the number of stitches drawn — \"stitches\" are the individual needle penetrations that make up an embroidery design. Spoken aloud, never shown on screen, so prefer a natural spoken form over an abbreviation. Add the plural categories your language needs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stitch"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stitches"
                }
              }
            }
          }
        }
      }
    },
    "stage.canvas.accessibility.value": {
      "comment": "Spoken by VoiceOver as the contents of the embroidery stage once a design has finished stitching. %1$@ is the number of stitches, %2$@ the number of thread colours and %3$@ the design's size — all three arrive already translated and formatted. The separators are what make VoiceOver pause between the parts: use the punctuation and spacing your language reads naturally aloud. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@"
          }
        }
      }
    },
    "stage.canvas.accessibility.value.stitching": {
      "comment": "Spoken by VoiceOver as the contents of the embroidery stage while a design is being stitched. Deliberately carries no counts: this description is only re-read when a run starts or ends, so any number here would be spoken once at the start and be wrong for the rest of the run. Say that stitching is happening now — a user who has turned VoiceOver hints off has no other way to learn it from the stage itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stitching."
          }
        }
      }
    },
    "stage.canvas.accessibility.value.zoomed": {
      "comment": "Wraps the VoiceOver description of the embroidery stage once the user has zoomed in or out. %1$@ is the zoom level, %2$@ the description of what the stage holds; both arrive already translated. The zoom level comes first on purpose: VoiceOver re-reads this whole description after every zoom step, so the part that changed has to be heard before the user swipes on. Arguments are positional and may be reordered if that reads better aloud.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "stage.canvas.accessibility.zoom": {
      "comment": "How far the user has zoomed into the embroidery stage, spoken by VoiceOver after each zoom step. %1$@ is an already-formatted percentage, localized for the reader's region — do not add a percent sign. 100 per cent means the whole design fits on screen. Spoken, never shown on screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom %1$@."
          }
        }
      }
    },
    "stage.empty.description": {
      "comment": "Explains the empty stage. Tells the user the one action available right now: pick a design from the list. \"Stitches\" are the individual needle penetrations that make up an embroidery design.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an example design to watch its stitches appear here."
          }
        }
      }
    },
    "stage.empty.title": {
      "comment": "Title of the empty state shown on the stage before any design has been chosen. Not an error — it is the app's normal starting state.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Design Selected"
          }
        }
      }
    },
    "stage.export.error.color.limit": {
      "comment": "Shown under the stage, and spoken as the disabled Share button's hint, when the design cannot be written because the DST format's colour-block field is too narrow. %lld is the format's limit. A \"colour block\" is one stretch of a single thread colour: the first colour, plus one more after every colour change - so the limit is one FEWER colour changes than the number given. Do not translate this as \"colours\": a design alternating red and blue has two colours but many blocks. Deliberately not pluralised - the argument is a fixed property of the file format (always 99), never a variable count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This design has too many colour blocks for a DST file, which allows %lld."
          }
        }
      }
    },
    "stage.export.error.size.limit": {
      "comment": "Shown under the stage, and spoken as the disabled Share button's hint, when the design cannot be written because the DST format's extent fields are too narrow. %@ is an already-formatted length including its unit, localized for the reader's region - do not add a unit and do not convert it. The DST format measures a design outward from its FIRST stitch rather than from its centre, which is why the sentence says so.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This design is too large for a DST file, which reaches at most %@ from the first stitch in any direction."
          }
        }
      }
    },
    "stage.export.error.stitch.limit": {
      "comment": "Shown under the stage, and spoken as the disabled Share button's hint, when the design cannot be written because the DST format's stitch-count field is too narrow. %lld is the format's limit. \"Stitches\" are the individual needle penetrations that make up a design. The design stays on screen and can still be run again - this is not a crash and not a lost design. Deliberately not pluralised - the argument is a fixed property of the file format (always 999999), never a variable count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This design has too many stitches for a DST file, which allows %lld."
          }
        }
      }
    },
    "stage.export.error.unknown": {
      "comment": "Shown under the stage, and spoken as the disabled Share button's hint, when the design cannot be written for a reason with no more specific message. A fallback for completeness: it covers the six header fields that ADR-025 records as unable to overflow, so users are not expected to see it. It exists instead of inventing copy for six unreachable states. The design stays on screen and can still be run again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This design cannot be saved as a DST file."
          }
        }
      }
    },
    "stage.export.error.write.failed": {
      "comment": "Shown under the stage when the finished design could not be written to a temporary file before sharing - a full disk, for example. Distinct from the messages about the file format's limits: nothing is wrong with the design itself, so trying again is worth suggesting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The design could not be saved. Try again."
          }
        }
      }
    },
    "stage.export.hint.name.empty": {
      "comment": "VoiceOver hint on the dimmed Share button when the design-name field is empty. Points at the field above the button; keep it consistent with stage.name.error.empty without repeating its whole sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a design name first."
          }
        }
      }
    },
    "stage.export.hint.name.invalid": {
      "comment": "VoiceOver hint on the dimmed Share button when the design name breaks a rule - too long, or a character the file format cannot store. Deliberately does not repeat which rule: the message under the field says that, and this is spoken after the field has already been read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The design name needs fixing first."
          }
        }
      }
    },
    "stage.export.hint.not.run": {
      "comment": "VoiceOver hint on the dimmed Share button, when a design has been chosen but not yet run. Says why the button cannot be used and what to do about it. \"Play\" must match stage.run.play exactly, or the hint names a button the user cannot find. There is no way to export a design mid-run, so this is the whole reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available once the design has been stitched. Press Play."
          }
        }
      }
    },
    "stage.export.hint.running": {
      "comment": "VoiceOver hint on the dimmed Share button while a design is being stitched. Both endings produce an exportable file, which is why Stop is named - stopping keeps the stitches. \"Stop\" must match stage.run.stop exactly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available when the design finishes, or when you press Stop."
          }
        }
      }
    },
    "stage.export.nothing.embroiderable": {
      "comment": "Shown under the stage, and spoken as the dimmed Share button's hint, when a design draws on screen but produces no stitches a machine could sew - every position it asked for was outside what the file format can represent. Not a run failure: the design is still on screen and can still be run again. Distinguish it from the empty state, which means nothing was drawn at all.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in this design can be embroidered."
          }
        }
      }
    },
    "stage.export.share": {
      "comment": "Title of the button that sends the finished design out through the system share sheet, and also the button's VoiceOver label. \"DST\" is the name of the Tajima file format embroidery machines read - keep it in Latin letters and uppercase, as file-format names are not translated. A verb in the imperative, matching stage.run.play.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share DST File"
          }
        }
      }
    },
    "stage.export.thread.colors": {
      "comment": "Shown under the Share DST File button whenever that button is visible, and read by VoiceOver right after it. Information, not a warning: the exported file is correct. The DST embroidery format records only where stitches go and where the thread changes, never which colour, so every embroidery machine or viewer app assigns its own colours to each thread section, and the colours chosen on screen will not appear in the file. \"DST\" is the Tajima file-format name: keep it in Latin letters and uppercase. \"Thread\" means embroidery thread.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DST files don't store thread colours. The machine or viewer chooses them."
          }
        }
      }
    },
    "stage.export.too.few.stitches": {
      "comment": "Shown under the stage, and spoken as the dimmed Share button's hint, when a design ran but produced fewer than two stitches - so there is nothing a machine could sew. \"Stitches\" are the individual needle penetrations. Covers both a design that stitched nothing and one that stitched a single point; they are one sentence to a reader even though they are different facts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A design needs at least two stitches before it can be embroidered."
          }
        }
      }
    },
    "stage.hoop.size": {
      "comment": "Physical size of the embroidery hoop the stage represents, e.g. \"Hoop 100 mm × 100 mm\". Both arguments are already-formatted lengths including their unit, localized for the reader's region — do not add a unit. The separator is the multiplication sign U+00D7, not the letter x. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoop %1$@ × %2$@"
          }
        }
      }
    },
    "stage.name.accessibility.hint": {
      "comment": "VoiceOver hint for the design-name field. Spoken once when focus lands, so it states the rules rather than the current count - the count is deliberately never announced per keystroke. %lld is the maximum number of characters. \"Unaccented Latin letters\" means ASCII: the embroidery file format can only store those in its label field. Say the restriction as a property of the file format, never as a judgement about the reader's language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Up to %lld character. Unaccented Latin letters, digits and basic punctuation only."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Up to %lld characters. Unaccented Latin letters, digits and basic punctuation only."
                }
              }
            }
          }
        }
      }
    },
    "stage.name.counter": {
      "comment": "Live character counter beside the design-name field, e.g. \"14/15\". %1$lld is how many characters the user has typed, %2$lld the maximum allowed. Use the separator your language reads naturally between a count and a total; some languages prefer a word. Arguments are positional and may be reordered. Hidden from VoiceOver on purpose (the field's hint states the limit instead), so it need not read well aloud - but keep it short, because at large text sizes it moves onto its own line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "stage.name.error.character": {
      "comment": "Shown under the design-name field when the name contains a character the DST file format cannot store. %1$@ is the offending character itself, already surrounded by this string's own quotation marks - use the quotation marks your language uses. For a character with no visible shape the argument arrives as a Unicode code point like \"U+0009\" instead. The rule is a property of the embroidery file format - it stores only unaccented Latin letters, digits and basic punctuation - so word it as a limit of the format, never as something wrong with the reader's language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” cannot be stored in a DST file name."
          }
        }
      }
    },
    "stage.name.error.empty": {
      "comment": "Shown under the design-name field when it is empty. Explains a requirement rather than reporting a mistake: an unnamed design produces a file with a blank label, which is what the Android and older iOS apps do and what this app exists not to do.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name so the file has one."
          }
        }
      }
    },
    "stage.name.error.too.long": {
      "comment": "Shown under the design-name field when the name is longer than the file format allows. %lld is the limit. The counter beside the field already shows how many characters were typed, so do not repeat that number here.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A design name can be at most %lld character."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A design name can be at most %lld characters."
                }
              }
            }
          }
        }
      }
    },
    "stage.name.label": {
      "comment": "Visible label of the text field where the user names their embroidery design, on the stage screen. The name is written into the DST file's own label field, which an embroidery machine displays. Also the field's VoiceOver label, so it must read as a name for the field, not as an instruction. Keep it short - it sits above a field only 15 characters wide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design name"
          }
        }
      }
    },
    "stage.name.prompt": {
      "comment": "Placeholder inside the design-name field, shown only when the field is empty. An instruction, not an example name. Do not translate it as a default name - an empty name is not allowed and the user must type something.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name this design"
          }
        }
      }
    },
    "stage.outside.hoop": {
      "comment": "Shown under the stage when the design extends beyond the 100 mm hoop outline. A neutral statement, not an error: the design is still shown in full and can still be exported, it simply would not fit this hoop. The hoop's size is stated in the caption directly above this line, so do not repeat it here.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of this design lies outside the hoop."
          }
        }
      }
    },
    "stage.ready.description": {
      "comment": "Explains the waiting stage. \"Play\" is the name of the button that starts the design - use the same word your locale uses for a play/start button. \"Stitches\" are the individual needle penetrations that make up an embroidery design; \"hoop\" is the frame that holds the fabric in an embroidery machine.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Play to watch the stitches appear inside the hoop."
          }
        }
      }
    },
    "stage.ready.title": {
      "comment": "Title of the state shown on the stage when a design has been chosen but has not been run yet. Not an error and not a loading state - the design is ready and waiting for the user to start it. Title case, matching the other empty-state titles.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to Stitch"
          }
        }
      }
    },
    "stage.run.limit.notice": {
      "comment": "Shown beneath the preview when a design was stopped because it produced more stitches than the preview will draw — typically a design that repeats forever. %lld is the number of stitches reached. Not an error: the stitches shown are real and the design can still be exported. Pluralised on the stitch count; add the categories your language needs (zero/one/two/few/many as applicable).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Preview stopped after %lld stitch."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Preview stopped after %lld stitches."
                }
              }
            }
          }
        }
      }
    },
    "stage.run.play": {
      "comment": "Title of the button that starts stitching the design in the on-screen preview. A verb in the imperative — this is the transport control on a design that has not run yet. It is also the button's VoiceOver label, so it must read as an action, not as a noun.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play"
          }
        }
      }
    },
    "stage.run.play.again": {
      "comment": "Title of the button that restarts a preview that has finished, replacing the previous run. Deliberately distinct from stage.run.play: a VoiceOver user who cannot see the finished design learns from this label alone that the run has ended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play Again"
          }
        }
      }
    },
    "stage.run.stop": {
      "comment": "Title of the button that stops the running preview. The same button as stage.run.play, which swaps to this while a design is being stitched. Stopping keeps the stitches already made and the design stays exportable, so avoid a word that implies cancelling or discarding.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "stage.title": {
      "comment": "Title of the screen showing the embroidery stage — the area where a design's stitches are drawn. On iPad this labels the detail pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage"
          }
        }
      }
    }
  },
  "version": "1.2"
}
