    },
    "script.action.delete": {
      "comment": "VoiceOver action on a brick in the script list: deletes it. On a loop, deletes the whole loop and everything inside it; it can be undone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "script.action.move.above.else": {
      "comment": "VoiceOver action on a brick in a design's program. 'If' means an If or If/Else block, the bricks between its If row and its End if row. On the first brick after an Else row: moves the brick to just above the Else row, so it runs when the condition is true instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Above Else"
          }
        }
      }
    },
    "script.action.move.above.if": {
      "comment": "VoiceOver action on a brick in a design's program. 'If' means an If or If/Else block, the bricks between its If row and its End if row. On the first brick inside an If: takes the brick out of the If and puts it just above it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Above If"
          }
        }
      }
    },
    "script.action.move.above.loop": {
      "comment": "VoiceOver action on the first brick inside a loop (a Repeat or Forever block): takes the brick out of the loop and puts it just above it. 'Loop' means the Repeat/Forever block the brick is inside.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Above Loop"
          }
        }
      }
    },
    "script.action.move.below.else": {
      "comment": "VoiceOver action on a brick in a design's program. 'If' means an If or If/Else block, the bricks between its If row and its End if row. On the last brick before an Else row: moves the brick to just below the Else row, so it runs when the condition is false instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Below Else"
          }
        }
      }
    },
    "script.action.move.below.if": {
      "comment": "VoiceOver action on a brick in a design's program. 'If' means an If or If/Else block, the bricks between its If row and its End if row. On the last brick inside an If: takes the brick out of the If and puts it just below its End if row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Below If"
          }
        }
      }
    },
    "script.action.move.below.loop": {
      "comment": "VoiceOver action on the last brick inside a loop (a Repeat or Forever block): takes the brick out of the loop and puts it just below it. 'Loop' means the Repeat/Forever block the brick is inside.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Below Loop"
          }
        }
      }
    },
    "script.action.move.down": {
      "comment": "VoiceOver action on a brick in the script list: moves the brick below the brick (or whole loop) after it. Short imperative, like a menu item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Down"
          }
        }
      }
    },
    "script.action.move.into.if.above": {
      "comment": "VoiceOver action on a brick in a design's program. 'If' means an If or If/Else block, the bricks between its If row and its End if row. On a brick just below an If: puts the brick inside that If, as its last brick.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Into If Above"
          }
        }
      }
    },
    "script.action.move.into.if.below": {
      "comment": "VoiceOver action on a brick in a design's program. 'If' means an If or If/Else block, the bricks between its If row and its End if row. On a brick just above an If: puts the brick inside that If, as its first brick.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Into If Below"
          }
        }
      }
    },
    "script.action.move.into.loop.above": {
      "comment": "VoiceOver action on a brick just below a loop (a Repeat or Forever block): puts the brick inside that loop, as its last brick. 'Loop' means the Repeat/Forever block.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Into Loop Above"
          }
        }
      }
    },
    "script.action.move.into.loop.below": {
      "comment": "VoiceOver action on a brick just above a loop (a Repeat or Forever block): puts the brick inside that loop, as its first brick. 'Loop' means the Repeat/Forever block.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Into Loop Below"
          }
        }
      }
    },
    "script.action.move.up": {
      "comment": "VoiceOver action on a brick in the script list: moves the brick above the brick (or whole loop) before it. Short imperative, like a menu item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Up"
          }
        }
      }
    },
    "script.add": {
      "comment": "Button in the script's toolbar, and under the empty state, that opens the list of bricks to add. 'Brick' is Catrobat's name for a block.",
      "extractionState": "manual",
      "localizations": {
