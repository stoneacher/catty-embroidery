          "stringUnit": {
            "state": "translated",
            "value": "Add Brick"
          }
        }
      }
    },
    "script.empty.description": {
      "comment": "Below 'No Bricks Yet', above the 'Add Brick' button. Names the action, so it reads naturally with the button directly under it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
