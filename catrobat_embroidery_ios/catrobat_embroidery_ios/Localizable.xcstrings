    },
    "brick.wait.count": {
      "comment": "One block (brick) in the list of a design's program, read as an instruction. Shown on screen and spoken by VoiceOver. Pauses the program. %lld is a whole number written literally in the block; this form is used only then, so that the unit agrees with it (\"1 second\", \"2 seconds\"). Add the plural categories your language needs. Word order is yours: the value is interpolated, not appended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
