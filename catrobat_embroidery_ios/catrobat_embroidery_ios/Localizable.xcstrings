    "project.default.name": {
      "comment": "The name a new, blank design gets (and the name of its embroidery file). It is written into the machine file, so it must be at most 15 characters of plain ASCII (letters, digits, spaces, common punctuation); a translation that is not falls back to English. Keep it short and generic.",
      "extractionState": "manual",
      "localizations": {
