    "thread.color.purple": {
      "comment": "Embroidery thread colour name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purple"
          }
        }
      }
    },
    "thread.color.red": {
      "comment": "Embroidery thread colour name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red"
          }
        }
      }
    },
    "thread.color.royal.blue": {
      "comment": "Embroidery thread colour name: a bright, deep blue.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Royal Blue"
          }
        }
      }
    },
    "thread.color.teal": {
      "comment": "Embroidery thread colour name: a blue-green.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teal"
          }
        }
      }
    },
    "thread.color.white": {
      "comment": "Embroidery thread colour name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "White"
          }
        }
      }
    },
    "thread.color.yellow": {
      "comment": "Embroidery thread colour name.",
