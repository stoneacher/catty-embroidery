    "formula.sensor.object.y": {
      "comment": "A value read from the object while the program runs: its y position. Catroid's formula-editor name (formula_editor_object_y).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "position y"
          }
        }
      }
    },
    "formula.smaller.or.equal": {
      "comment": "A comparison inside a block's value, e.g. in \"Counter < 10\". %1$@ and %2$@ are its two operands, already formatted. Catroid's own symbol for it (formula_editor_logic_leserequal); keep the spaces unless your language does not use them. True when %1$@ is smaller than or equal to %2$@.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ≤ %2$@"
          }
        }
      }
    },
    "formula.smaller.than": {
      "comment": "A comparison inside a block's value, e.g. in \"Counter < 10\". %1$@ and %2$@ are its two operands, already formatted. Catroid's own symbol for it (formula_editor_logic_lesserthan); keep the spaces unless your language does not use them. True when %1$@ is smaller than %2$@.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ < %2$@"
          }
        }
      }
    },
    "formula.variable": {
      "comment": "A variable's name inside a block's value, e.g. the \"Inner Loop\" in 360 ÷ \"Inner Loop\". %@ is the name, chosen by the user and never translated. The quotes are what keep a name like \"a + b\" reading as one variable rather than as a sum — use your language's quotation marks, but keep them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\""
          }
        }
      }
    },
    "history.redid.adding": {
      "comment": "VoiceOver announcement after the user undoes or redoes a change to the design's script, spoken because the change may be off-screen. The user redid adding a brick, which is back in the script. %@ is the brick as the script list reads it, for example “Repeat 31 times” or “Move 10 steps”; it is already translated.",
