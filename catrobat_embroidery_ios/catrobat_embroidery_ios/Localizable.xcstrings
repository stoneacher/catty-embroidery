      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Brick"
          }
        }
      }
    },
    "parameter.literal.error.empty": {
      "comment": "Shown under the number field when it is empty. Nothing is changed until a number is entered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a number."
          }
        }
      }
    },
    "parameter.literal.error.malformed": {
      "comment": "Shown under the number field when the text is not a number. Nothing is changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a number. Use digits, an optional minus sign and one decimal separator."
          }
        }
      }
    },
    "parameter.literal.error.too.large": {
      "comment": "Shown under the number field when the number is too large to be stored. Nothing is changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That number is too large to save."
          }
        }
      }
    },
    "parameter.name.error.bracket": {
      "comment": "Shown under the variable-name field. Placeholders such as \"(no variable)\" start with a bracket, so a name may not.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name can't start with a bracket."
          }
        }
      }
    },
    "parameter.name.error.control": {
      "comment": "Shown under the variable-name field when it contains a line break, a tab, or an invisible character such as a zero-width space.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name can't contain line breaks or invisible characters."
          }
        }
      }
    },
    "parameter.name.error.empty": {
      "comment": "Shown under the variable-name field when it is empty.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name for the variable."
          }
        }
      }
    },
    "parameter.name.error.quote": {
      "comment": "Shown under the variable-name field. Variable names are shown inside quotation marks, so a name containing one would be misread.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name can't contain quotation marks."
          }
        }
      }
    },
    "parameter.name.error.whitespace": {
      "comment": "Shown under the variable-name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name can't start or end with a space."
          }
        }
      }
    },
    "parameter.name.prompt": {
      "comment": "Placeholder in the text field where a variable's name is typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variable name"
          }
        }
      }
    },
    "parameter.readonly.binary": {
      "comment": "Explains why a value cannot be edited: it is a formula with an operator such as + or ÷, which a later version of the app will be able to edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This value is a calculation. Calculations can't be edited yet, so it is kept exactly as it is."
          }
        }
      }
    },
    "parameter.readonly.function": {
      "comment": "Explains why a value cannot be edited: it contains a math function such as sine or modulo, and the app has no formula editor yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This value uses a math function. Functions can't be edited yet, so it is kept exactly as it is."
          }
        }
      }
    },
    "parameter.readonly.logic": {
      "comment": "Explains why a value cannot be edited: it is a condition the app cannot edit yet, such as two comparisons joined with 'and', 'or' or 'not', or a comparison used where a number is expected. A single comparison of two values in an If or a loop can be edited.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a single comparison of two values in a condition can be edited. This one can't be edited yet, so it is kept exactly as it is."
          }
        }
      }
    },
    "parameter.readonly.negation": {
      "comment": "Explains why a value cannot be edited: it is a formula with a minus sign in front, which a later version of the app will be able to edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This value is a negated formula. It can't be edited yet, so it is kept exactly as it is."
          }
        }
      }
    },
    "parameter.readonly.sensor": {
      "comment": "Explains why a value cannot be edited: it reads the object's x or y position or its direction, and the app has no formula editor yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This value reads the object's position or direction while the program runs. It can't be edited yet, so it is kept exactly as it is."
          }
        }
      }
    },
