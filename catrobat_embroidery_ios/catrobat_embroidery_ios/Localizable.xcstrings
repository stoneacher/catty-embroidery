    "project.row.accessibility.label.newer": {
      "comment": "Spoken by VoiceOver for one of the user's designs that was made with a newer version of this app: it cannot be opened, only deleted. %1$@ is the design's name, %2$@ a relative time that arrives already translated. Must agree with project.row.badge.newer. Arguments are positional and may be reordered.",
      "extractionState": "manual",
      "localizations": {
