          <soundList/>
          <scriptList>
            <script type="WhenClonedScript">
              <brickList>
                <brick type="PlaceAtBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="X_POSITION">
                      <type>NUMBER</type>
                      <value>0</value>
                    </formula>
                    <formula category="Y_POSITION">
                      <rightChild>
                        <type>NUMBER</type>
                        <value>450</value>
                      </rightChild>
                      <type>OPERATOR</type>
                      <value>MINUS</value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="BroadcastBrick">
                  <commentedOut>false</commentedOut>
                  <broadcastMessage>cloneInitialized</broadcastMessage>
                </brick>
              </brickList>
              <commentedOut>false</commentedOut>
            </script>
            <script type="StartScript">
              <brickList>
                <brick type="CloneBrick">
                  <commentedOut>false</commentedOut>
                </brick>
              </brickList>
              <commentedOut>false</commentedOut>
