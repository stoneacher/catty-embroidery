<program>
  <header>
    <applicationBuildName></applicationBuildName>
    <applicationBuildNumber>0</applicationBuildNumber>
    <applicationBuildType>debug</applicationBuildType>
    <applicationName>Pocket Code</applicationName>
    <applicationVersion>0.9.69</applicationVersion>
    <catrobatLanguageVersion>0.99995</catrobatLanguageVersion>
    <dateTimeUpload></dateTimeUpload>
    <description></description>
    <deviceName>SM-N950F</deviceName>
    <isCastProject>false</isCastProject>
    <landscapeMode>false</landscapeMode>
    <mediaLicense></mediaLicense>
    <platform>Android</platform>
    <platformVersion>28</platformVersion>
    <programLicense></programLicense>
    <programName>testBroadcastSpeed</programName>
    <remixOf></remixOf>
    <scenesEnabled>true</scenesEnabled>
    <screenHeight>1480</screenHeight>
    <screenMode>STRETCH</screenMode>
    <screenWidth>720</screenWidth>
    <tags></tags>
    <url></url>
    <userHandle></userHandle>
  </header>
  <settings/>
  <scenes>
    <scene>
      <name>Scene 1</name>
      <objectList>
        <object type="Sprite" name="Background">
          <lookList/>
          <soundList/>
          <scriptList>
            <script type="StartScript">
              <brickList>
                <brick type="NoteBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="NOTE">
                      <type>STRING</type>
                      <value>A loop made with a Forever (or Repeat until) brick that contains bricks that change the stage, is slowed down to a minimum of 20 ms per iteration. Loops made with broadcast bricks do not have this slowdown built-in. The MINIMUM SPEEDUP FACTOR depends on the speed of the device on which the project is executed, and can be much higher on faster devices.</value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="SetVariableBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="VARIABLE">
                      <type>FUNCTION</type>
                      <value>TRUE</value>
                    </formula>
                  </formulaList>
                  <userVariable type="UserVariable" serialization="custom">
                    <userVariable>
                      <default>
                        <deviceValueKey>005dd89f-d131-4401-8468-3e8694ccdc92</deviceValueKey>
                        <name>start counting</name>
                      </default>
                    </userVariable>
                  </userVariable>
                </brick>
                <brick type="WaitBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="TIME_TO_WAIT_IN_SECONDS">
                      <type>NUMBER</type>
                      <value>1.5</value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="SetVariableBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="VARIABLE">
                      <type>FUNCTION</type>
                      <value>TRUE</value>
                    </formula>
                  </formulaList>
                  <userVariable type="UserVariable" serialization="custom">
                    <userVariable>
                      <default>
                        <deviceValueKey>e0eeaac6-55f6-430a-b26c-c0469f399b92</deviceValueKey>
                        <name>stop counting</name>
                      </default>
                    </userVariable>
                  </userVariable>
                </brick>
                <brick type="SetVariableBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="VARIABLE">
                      <type>NUMBER</type>
                      <value>2</value>
                    </formula>
                  </formulaList>
                  <userVariable type="UserVariable" serialization="custom">
                    <userVariable>
                      <default>
                        <deviceValueKey>65c5f105-d947-4c58-8944-dbebbfaf0a84</deviceValueKey>
                        <name>MINIMUM SPEEDUP FACTOR</name>
                      </default>
                    </userVariable>
                  </userVariable>
                </brick>
                <brick type="AssertEqualsBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="ASSERT_EQUALS_EXPECTED">
                      <type>FUNCTION</type>
                      <value>TRUE</value>
                    </formula>
                    <formula category="ASSERT_EQUALS_ACTUAL">
                      <leftChild>
                        <type>USER_VARIABLE</type>
                        <value>Fast counter</value>
                      </leftChild>
                      <rightChild>
                        <leftChild>
                          <type>USER_VARIABLE</type>
                          <value>MINIMUM SPEEDUP FACTOR</value>
                        </leftChild>
                        <rightChild>
                          <type>USER_VARIABLE</type>
                          <value>Slow counter</value>
                        </rightChild>
                        <type>OPERATOR</type>
                        <value>MULT</value>
                      </rightChild>
                      <type>OPERATOR</type>
                      <value>GREATER_OR_EQUAL</value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="FinishStageBrick">
                  <commentedOut>false</commentedOut>
                </brick>
              </brickList>
              <commentedOut>false</commentedOut>
            </script>
          </scriptList>
          <nfcTagList/>
          <userVariables/>
          <userLists/>
        </object>
        <object type="Sprite" name="Slowed down forever loop">
          <lookList>
            <look fileName="My actor or object.png" name="rotating bar (do NOT delete!)"/>
          </lookList>
          <soundList/>
          <scriptList>
            <script type="WhenConditionScript">
              <brickList>
                <brick type="NoteBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="NOTE">
                      <type>STRING</type>
                      <value>The rotating look in the Forever loop  ensures that the latter is slowed down to a minimum of 20 ms per iteration.</value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="SetYBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="Y_POSITION">
                      <type>NUMBER</type>
                      <value>200</value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="ForeverBrick">
                  <commentedOut>false</commentedOut>
                  <loopBricks>
                    <brick type="IfThenLogicBeginBrick">
                      <commentedOut>false</commentedOut>
                      <formulaList>
                        <formula category="IF_CONDITION">
                          <rightChild>
                            <type>USER_VARIABLE</type>
                            <value>stop counting</value>
                          </rightChild>
                          <type>OPERATOR</type>
                          <value>LOGICAL_NOT</value>
                        </formula>
                      </formulaList>
                      <ifBranchBricks>
                        <brick type="ChangeVariableBrick">
                          <commentedOut>false</commentedOut>
                          <formulaList>
                            <formula category="VARIABLE_CHANGE">
                              <type>NUMBER</type>
                              <value>1.0</value>
                            </formula>
                          </formulaList>
                          <userVariable type="UserVariable" serialization="custom">
                            <userVariable>
                              <default>
                                <deviceValueKey>0daa4eb5-ab6a-4fad-8077-a19a77e29799</deviceValueKey>
                                <name>Slow counter</name>
                              </default>
                            </userVariable>
                          </userVariable>
                        </brick>
                        <brick type="TurnLeftBrick">
                          <commentedOut>false</commentedOut>
                          <formulaList>
                            <formula category="TURN_LEFT_DEGREES">
                              <type>NUMBER</type>
                              <value>15.0</value>
                            </formula>
                          </formulaList>
                        </brick>
                      </ifBranchBricks>
                    </brick>
                  </loopBricks>
                </brick>
              </brickList>
              <commentedOut>false</commentedOut>
              <formulaMap>
                <formula category="IF_CONDITION">
                  <type>USER_VARIABLE</type>
                  <value>start counting</value>
                </formula>
              </formulaMap>
            </script>
          </scriptList>
          <nfcTagList/>
          <userVariables/>
          <userLists/>
        </object>
        <object type="SingleSprite" name="Fast broadcast loop">
          <lookList>
            <look fileName="My actor or object_#0.png" name="rotating bar (do NOT delete!)"/>
          </lookList>
          <soundList/>
          <scriptList>
            <script type="WhenConditionScript">
              <brickList>
                <brick type="NoteBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="NOTE">
                      <type>STRING</type>
                      <value>To provide the same workload as in the object with the forever loop, the broadcast loop here also has the same rotating look. </value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="SetYBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="Y_POSITION">
                      <rightChild>
                        <type>NUMBER</type>
                        <value>200</value>
                      </rightChild>
                      <type>OPERATOR</type>
                      <value>MINUS</value>
                    </formula>
                  </formulaList>
                </brick>
                <brick type="BroadcastBrick">
                  <commentedOut>false</commentedOut>
                  <broadcastMessage>loop</broadcastMessage>
                </brick>
              </brickList>
              <commentedOut>false</commentedOut>
              <formulaMap>
                <formula category="IF_CONDITION">
                  <type>USER_VARIABLE</type>
                  <value>start counting</value>
                </formula>
              </formulaMap>
            </script>
            <script type="BroadcastScript">
              <brickList>
                <brick type="IfThenLogicBeginBrick">
                  <commentedOut>false</commentedOut>
                  <formulaList>
                    <formula category="IF_CONDITION">
                      <rightChild>
                        <type>USER_VARIABLE</type>
                        <value>stop counting</value>
                      </rightChild>
                      <type>OPERATOR</type>
                      <value>LOGICAL_NOT</value>
                    </formula>
                  </formulaList>
                  <ifBranchBricks>
                    <brick type="ChangeVariableBrick">
                      <commentedOut>false</commentedOut>
                      <formulaList>
                        <formula category="VARIABLE_CHANGE">
                          <type>NUMBER</type>
                          <value>1.0</value>
                        </formula>
                      </formulaList>
                      <userVariable type="UserVariable" serialization="custom">
                        <userVariable>
                          <default>
                            <deviceValueKey>7292eca8-d521-48d1-ad32-b3d8021d716e</deviceValueKey>
                            <name>Fast counter</name>
                          </default>
                        </userVariable>
                      </userVariable>
                    </brick>
                    <brick type="TurnLeftBrick">
                      <commentedOut>false</commentedOut>
                      <formulaList>
                        <formula category="TURN_LEFT_DEGREES">
                          <type>NUMBER</type>
                          <value>15.0</value>
                        </formula>
                      </formulaList>
                    </brick>
                  </ifBranchBricks>
                </brick>
                <brick type="BroadcastBrick">
                  <commentedOut>false</commentedOut>
                  <broadcastMessage>loop</broadcastMessage>
                </brick>
              </brickList>
              <commentedOut>false</commentedOut>
              <receivedMessage>loop</receivedMessage>
            </script>
          </scriptList>
          <nfcTagList/>
          <userVariables/>
          <userLists/>
        </object>
      </objectList>
    </scene>
  </scenes>
