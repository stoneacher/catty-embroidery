    <userVariable reference="../../scenes/scene/objectList/object/scriptList/script/brickList/brick[5]/userVariable"/>
    <userVariable reference="../../scenes/scene/objectList/object[2]/scriptList/script/brickList/brick[3]/loopBricks/brick/ifBranchBricks/brick/userVariable"/>
    <userVariable reference="../../scenes/scene/objectList/object[3]/scriptList/script[2]/brickList/brick/ifBranchBricks/brick/userVariable"/>
    <userVariable reference="../../scenes/scene/objectList/object/scriptList/script/brickList/brick[2]/userVariable"/>
