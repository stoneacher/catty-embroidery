{"nodes": [{"id": "docs_user_stories_milestone_1_us_109_triple_stitch_and_sew_up_us_109", "label": "US-109 \u2014 Triple stitch pattern and sew-up", "file_type": "document", "source_file": "docs/user-stories/milestone-1/US-109-triple-stitch-and-sew-up.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SewUp is Catroid's 5-point centre/ahead/centre/behind/centre sequence, not Catty's 4-point variant. The dedup interaction is made explicit by test: if the needle just stitched at the sew-up's centre, dedup drops the first centre point and 4 records are emitted, matching Catroid \u2014 the single-actor slice of the dedup rule landed here to make that test executable."}], "edges": [{"source": "docs_user_stories_milestone_1_us_109_triple_stitch_and_sew_up_us_109", "target": "docs_user_stories_milestone_1_us_107_running_stitch_pattern_us_107", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-109-triple-stitch-and-sew-up.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_109_triple_stitch_and_sew_up_us_109", "target": "docs_user_stories_milestone_1_us_107_running_stitch_pattern_stitchpattern_protocol", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-109-triple-stitch-and-sew-up.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_109_triple_stitch_and_sew_up_us_109", "target": "docs_decisions_adr_012", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-109-triple-stitch-and-sew-up.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_109_triple_stitch_and_sew_up_us_109", "target": "docs_user_stories_milestone_1_us_110_thread_color_and_layers_us_110", "relation": "conc