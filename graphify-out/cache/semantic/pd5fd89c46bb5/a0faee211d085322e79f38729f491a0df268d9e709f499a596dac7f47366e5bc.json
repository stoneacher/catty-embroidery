{"nodes": [{"id": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_us_102", "label": "US-102 \u2014 Stitch domain model and embroidery stream", "file_type": "document", "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared representation for all pattern generators and the DST writer. EmbroideryStream is a plain Sendable struct with mutating appends \u2014 Catty's class + SynchronizedArray + draw-queue design is deliberately not ported, because M3's preview only needs 'stitches since index i', which an array gives for free."}, {"id": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_embroiderystream", "label": "EmbroideryStream (stitch accumulation and metadata)", "file_type": "concept", "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes stitch count, colour-change count, bounding box and first/last stitch positions precisely because the DST header's ST, CO, extents and AX/AY derive from them with no caller-supplied redundancy. It is also the single writer, owning interpolation, dedup and pending flags, which is why stitch patterns return positions instead of writing into it."}], "edges": [{"source": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_us_102", "target": "docs_user_stories_milestone_1_us_101_project_scaffold_and_ci_us_101", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_us_102", "target": "docs_decisions_adr_012", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_us_102", "target": "docs_decisions_adr_007", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_us_102", "target": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_embroiderystream", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_embroiderystream", "target": "docs_decisions_javaround", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "weight": 1.0}, {"source": "docs_user_stories_milestone_1_us_102_stitch_model_and_stream_us_102", "target": "docs_roadmap_e2_embroidery_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/user-stories/milestone-1/US-102-stitch-model-and-stream.md", "source_location": null, "weight": 1.0}], "hyperedges": []}